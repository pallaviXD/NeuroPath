# ─── Gemini AI (required for PDF lessons, sign language, struggle detection) ───
# Get your key at https://aistudio.google.com/app/apikey (free tier available)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Firebase (required for real login/signup) ──────────────────────────────
# Create a project at https://console.firebase.google.com
# Enable: Authentication (Email/Password) + Firestore Database
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─── Without keys ───────────────────────────────────────────────────────────
# The app works fully without any keys using localStorage fallback for auth
# and offline AI fallbacks for lesson generation. Add keys to unlock full AI.
