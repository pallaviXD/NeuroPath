# Client-side key (local dev only — do NOT use in production builds you ship publicly)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server-side key for /api/gemini proxy (recommended for Vercel production)
GEMINI_API_KEY=your_gemini_api_key_here

# Route all Gemini calls through the server proxy (hides key from browser)
VITE_USE_GEMINI_PROXY=true
